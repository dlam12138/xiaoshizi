[Unit]
Description=UPC teacher and review cache API
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=upc-cache
Group=upc-cache
WorkingDirectory=/opt/upc-eval/current
EnvironmentFile=/etc/upc-eval-api.env
ExecStart=/usr/bin/node --max-old-space-size=192 /opt/upc-eval/current/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=384M
UMask=0077

[Install]
WantedBy=multi-user.target
