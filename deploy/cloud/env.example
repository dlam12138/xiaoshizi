# Copy to .env.cloud.local (Git ignored) and fill from the hosted project.
# Only public client values belong here.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<publishable-or-anon-key>"
VITE_CACHE_API_ENABLED="false"
VITE_API_BASE_URL=""
# Pre-release: hide registration entry points. Supabase Auth disable_signup is
# the real control and must be enabled separately.
VITE_REGISTRATION_OPEN="false"
VITE_PRE_RELEASE="true"
