# UPC static frontend, Nginx SPA example. Not applied in this round.
server {
    listen 80;
    server_name _;

    root /var/www/upc;
    index index.html;

    # Do not proxy /rest or /auth through this server; the browser talks to
    # the hosted Supabase project directly.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|webp|svg|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
}
