{
  "name": "upc-teacher-evaluation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "schema:build": "node scripts/build-schema.mjs",
    "import:upc": "node scripts/import-upc-data.mjs",
    "check:supabase": "node scripts/check-supabase-env.mjs",
    "check:supabase:remote": "node scripts/check-supabase-env.mjs --remote",
    "supabase:start": "node scripts/local-supabase.mjs start",
    "supabase:init": "npm run schema:build && node scripts/local-supabase.mjs init",
    "supabase:status": "node scripts/local-supabase.mjs status",
    "supabase:stop": "node scripts/local-supabase.mjs stop",
    "test:supabase:local": "node scripts/verify-local-supabase.mjs",
    "data:chemistry": "python scripts/upc-timetable/build_chemistry_dataset.py",
    "data:teacher-map": "python scripts/upc-timetable/build_teacher_map.py",
    "data:all-colleges": "python scripts/upc-timetable/build_all_colleges.py",
    "data:release": "node scripts/export-upc-release.mjs",
    "test:parser": "python -m unittest discover -s scripts/upc-timetable -p \"test_*.py\"",
    "test": "node --test tests/*.test.mjs",
    "test:server": "npm --prefix server test",
    "verify:local": "npm run schema:build && npm run lint && npm test && npm run build && npm run test:server"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
